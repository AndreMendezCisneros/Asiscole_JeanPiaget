# Build producción — Asis Academy (VPS)
VITE_APP_URL=https://demostracion.asisacademy.com
VITE_SCHOOL_NAME=Asis Academy
VITE_TALLERES_ENABLED=true
VITE_PENSIONES_ENABLED=true
# Academy: true + /canal-api + asis_academy para que citas/pensiones/notas salgan a la app.
# Encender en /opt/sie-academy/.env.build y rebuild. JP y San Ramón no usan este flag.
VITE_MOBILE_INGEST_ENABLED=false
VITE_MOBILE_INGEST_URL=/canal-api
VITE_MOBILE_INGEST_TENANT=asis_academy
VITE_OPENWA_ENABLED=false
VITE_OPENWA_API_URL=/api
